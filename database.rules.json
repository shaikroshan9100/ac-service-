{
  "rules": {
    "bookings": {
      ".read": "auth != null",
      "$bookingId": {
        ".write": "auth != null || !data.exists()",
        ".validate": "newData.hasChildren(['id','phone','name','service','date','time','address','status','createdAt'])",
        "id": {".validate": "newData.isString() && newData.val().length >= 6 && newData.val().length <= 30"},
        "phone": {".validate": "newData.isString() && newData.val().matches(/^[0-9]{10}$/)"},
        "status": {".validate": "newData.isString() && (newData.val() == 'Pending' || newData.val() == 'Confirmed' || newData.val() == 'Technician Assigned' || newData.val() == 'On The Way' || newData.val() == 'Completed' || newData.val() == 'Cancelled')"}
      }
    },
    "adminTokens": {
      ".read": false,
      "$token": {".write": "auth != null && newData.isString() && newData.val().length > 20"}
    }
  }
}
